// ============================================================================
// OBJ_FINAL_RESULTADO
// EVENTO STEP COMPLETO
// ============================================================================

// ============================================================================
// ANIMACION DE ENTRADA
// ============================================================================

alpha_panel =
    lerp(
        alpha_panel,
        1,
        0.08
    );

escala_panel =
    lerp(
        escala_panel,
        1,
        0.08
    );

desplazamiento_y =
    lerp(
        desplazamiento_y,
        0,
        0.08
    );

// ============================================================================
// AJUSTAR LIMITES
// ============================================================================

if (alpha_panel > 0.99)
{
    alpha_panel = 1;
}

if (abs(escala_panel - 1) < 0.005)
{
    escala_panel = 1;
}

if (abs(desplazamiento_y) < 0.5)
{
    desplazamiento_y = 0;
}

// ============================================================================
// PULSO
// ============================================================================

pulso =
    0.5
    +
    0.5
    *
    sin(
        current_time / 240
    );